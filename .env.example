APP_NAME="AMS E-Radio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://172.30.30.206:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
ADMIN_TIMEZONE=Asia/Phnom_Penh

# "Continue with Google" in the mobile app: the Google Cloud OAuth "Web
# application" client ID the app requests ID tokens for (comma-separate several).
# Leave empty to switch Google sign-in off.
GOOGLE_CLIENT_IDS=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

FFMPEG_BINARY=ffmpeg
FFMPEG_PROBE_BINARY=ffprobe
FFMPEG_HLS_BITRATE=128k
FFMPEG_HLS_TIMEOUT=300
FFMPEG_OPUS_BITRATE=64k
FFMPEG_OPUS_TIMEOUT=300
# Episodes whose audio is a YouTube link: fetched on the server with yt-dlp, shrunk to small mono Opus, and played
# in the app like any audio file. Needs yt-dlp plus Deno or Node installed (YouTube returns 403 without a JS
# runtime). If YouTube asks the server to "confirm you're not a bot", upload a fresh Netscape cookies.txt in
# Admin Settings → YouTube. The optional file fallback defaults to storage/app/youtube/cookies.txt.
FFMPEG_YOUTUBE_BITRATE=24k
FFMPEG_YOUTUBE_CHANNELS=1
YT_DLP_BINARY=yt-dlp
YT_DLP_TIMEOUT=300
YT_DLP_ATTEMPTS=3
YT_DLP_MAX_FILESIZE=300M
YT_DLP_JS_RUNTIMES=deno,node
# YT_DLP_COOKIES=C:/secure/path/cookies.txt
# Local development only: browser profile available to the Laravel queue worker (edge, chrome or firefox).
YT_DLP_COOKIES_FROM_BROWSER=
# Optional cookie-free fallback. Use the VISITOR_INFO1_LIVE visitor-data value, not a YouTube Data API key.
YT_DLP_VISITOR_DATA=
# The database queue re-offers a job that runs longer than this (seconds). A YouTube fetch can take several
# minutes, so keep it above the job's 720 s timeout.
DB_QUEUE_RETRY_AFTER=760

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional: connect the dashboard to your AzuraCast installation.
AZURACAST_URL=
AZURACAST_API_KEY=
AZURACAST_STATION_ID=azuratest
AZURACAST_TIMEOUT=5

# Optional: scrape live stations from radio-browser.info.
RADIO_BROWSER_ENABLED=false
RADIO_BROWSER_COUNTRY=KH

# Where new media content uploads are saved on the public disk. Also
# editable from /admin/settings once the app is running (Storage tab).
MEDIA_IMAGE_DIRECTORY=media-contents/thumbnails
MEDIA_AUDIO_DIRECTORY=media-contents/streams
